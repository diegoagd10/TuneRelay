#!/usr/bin/env python3
"""Fake notify-send / omarchy-osd / player / pass: records each call to $FAKE_LOG.

When invoked as `pass`, prints $FAKE_PASS_OUTPUT (or fails if $FAKE_PASS_FAIL is set).
"""

import json
import os
import sys
from pathlib import Path

name = Path(sys.argv[0]).name
with open(os.environ["FAKE_LOG"], "a") as fh:
    fh.write(json.dumps({"tool": name, "args": sys.argv[1:]}) + "\n")
if name == "pass":
    if os.environ.get("FAKE_PASS_FAIL"):
        sys.exit(1)
    print(os.environ.get("FAKE_PASS_OUTPUT", "secret"))
