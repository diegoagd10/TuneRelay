{
  "manifest_version": 3,
  "name": "TuneRelay",
  "version": "0.1.0",
  "description": "Capture the current YouTube song into TuneRelay (Alt+Shift+M)",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Capture song with TuneRelay"
  },
  "commands": {
    "capture": {
      "suggested_key": {"default": "Alt+Shift+M"},
      "description": "Capture the current song with TuneRelay"
    }
  },
  "background": {"service_worker": "background.js"}
}
